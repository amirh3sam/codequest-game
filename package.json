{
  "name": "codequest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-runtimes.mjs",
    "build": "tsc && vite build",
    "prebuild": "node scripts/copy-runtimes.mjs",
    "build:e2e": "tsc && vite build --mode e2e",
    "prebuild:e2e": "node scripts/copy-runtimes.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "typescript-js": "npm:typescript@6.0.3"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "pyodide": "^314.0.7",
    "typescript-js": "npm:typescript@^6.0.3"
  }
}
